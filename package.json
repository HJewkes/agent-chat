{
  "name": "agent-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-session messaging between Claude Code sessions, delivered over the channels capability",
  "bin": {
    "agent-chat": "./dist/cli.js"
  },
  "exports": {
    "./spawn-kernel": "./src/spawn-kernel.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "hono": "^4.12.33",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
