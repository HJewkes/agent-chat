[
  {
    "name": "healthy metadata port and uptime rounding up",
    "argv": [
      "service",
      "status"
    ],
    "calls": [
      {
        "name": "probeSocket"
      },
      {
        "name": "readMeta"
      },
      {
        "name": "probeHealth",
        "arg": 7600
      },
      {
        "name": "readPidFile"
      },
      {
        "name": "isProcessAlive",
        "arg": 123
      }
    ],
    "output": [
      "stdout: socket   up  /tmp/synthetic-service-status/chat.sock",
      "stdout: pid      123",
      "stdout: meta     version fixture-version  port 7600",
      "stdout: http     ok  uptime 2s  2 sessions  3 open"
    ],
    "exit": 0
  },
