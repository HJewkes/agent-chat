# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY and not a
# SYMLINK, so a worktree sharing the main checkout's install (`node_modules ->
# /path/to/agent-chat/node_modules`, which is how these worktrees avoid a second
# install) sailed straight past it and was committed by a `git add -A`.
node_modules
dist/

# Worktree isolation cuts agent worktrees here (isolation/worktree.ts's
# DEFAULT_BASE_PATH). They are checkouts of this same repo, so leaving them
# untracked put them in every session's `git status` and one `git add -A` away
# from being committed into it.
.worktrees/
*.log
*.tsbuildinfo

# gitleaks writes its report into the workspace during CI
results.sarif
