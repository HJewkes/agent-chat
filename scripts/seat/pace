#!/usr/bin/env python3
"""Print one PACE line per charter pool (CC-609). A read-only view once the seat watchdog publishes pace.

Usage: bin/pace. Env: AUTONOMY_ROOT, PACE_WATCHDOG (watchdog json), PACE_FILE (the watchdog's pace.json),
PACE_NOW (epoch seconds) for tests.
Target is a straight glide from the window start to the day 7 line at reset minus 24 h.
The watchdog pass is the one writer of pool-readings.jsonl (CC-605). This script appends a reading only
while no pass has written pace.json in the last hour, so the history has one writer at any time.
"""
import glob, json, os, re, time

ROOT = os.environ.get('AUTONOMY_ROOT') or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WATCHDOG = os.environ.get('PACE_WATCHDOG') or os.path.expanduser('~/.agent-chat/seat-watchdog.json')
PACE_FILE = os.environ.get('PACE_FILE') or os.path.expanduser('~/.agent-chat/pace.json')
HISTORY = os.path.join(ROOT, 'pool-readings.jsonl')
DAY, FINISH_EARLY, STALE_S, WRITER_QUIET_S = 86400, 86400, 900, 3600


def pools():
    text = open(os.path.join(ROOT, 'charter.md')).read().split('\n---', 1)[0]
    block = re.search(r'^pools:.*\n((?:[ \t]+.*\n?)*)', text, re.M).group(1)
    out = {}
    for name, body in re.findall(r'^[ \t]+([\w-]+):\s*\{([^}]*)\}', block, re.M):
        out[name] = dict(kv.strip().split(': ', 1) for kv in body.split(',') if ': ' in kv)
    return out


def cache_reading(config_dir):
    files = glob.glob(os.path.join(os.path.expanduser(config_dir), 'status-cache/sessions/*.json'))
    for path in sorted(files, key=os.path.getmtime, reverse=True):
        try:
            d = json.load(open(path))
            rl = d['rate_limits']
            return {'at': d['written_at'], 'seven_day': rl['seven_day']['used_percentage'],
                    'five_hour': rl['five_hour']['used_percentage'],
                    'resets_at': rl['seven_day']['resets_at'], 'source': 'status-cache'}
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return None


def reading(pool, cfg, watchdog):
    cache = cache_reading(cfg.get('config_dir', ''))
    w = watchdog.get(pool)
    if w and cache and w['at'] / 1000 > cache['at']:
        return dict(cache, at=w['at'] / 1000, seven_day=w['sevenDay'], five_hour=w['fiveHour'], source='watchdog')
    return cache


def pace_line(pool, r, reserve, now):
    reset, seven_day = r['resets_at'], r['seven_day']
    while reset <= now:
        reset += 7 * DAY
    rolled = reset != r['resets_at']
    if rolled:
        seven_day = 0  # the reading is last window's; the new window starts at 0
    start, goal_at = reset - 7 * DAY, reset - FINISH_EARLY
    d = min(7, int((now - start) // DAY) + 1)
    line, final = 100 - reserve * (8 - d) / 7, 100 - reserve / 7
    target = min(line, final, final * (now - start) / (goal_at - start))
    behind = target - seven_day
    needs = max(0, final - seven_day) / max((goal_at - now if goal_at > now else reset - now) / DAY, 1 / 24)
    left, age = reset - now, int(now - r['at'])
    return (f"PACE {pool:<8}{seven_day:>3.0f} | target {target:.0f} | "
            + (f'behind {behind:.0f}' if behind >= 0.5 else 'on pace')
            + f" | needs {needs:.1f}/day | 5h {r['five_hour']:.0f} | resets "
            + time.strftime('%a %H:%M', time.localtime(reset))
            + f' ({int(left // DAY)}d {int(left % DAY // 3600)}h) | reading {age // 60} min old'
            + (' stale' if age > STALE_S or rolled else ''))


def append_history(pool, r, now):
    row = {'ts': int(now), 'pool': pool, 'seven_day': r['seven_day'], 'five_hour': r['five_hour'],
           'resets_at': r['resets_at'], 'source': r['source'], 'age_s': int(now - r['at'])}
    keys = ('seven_day', 'five_hour', 'resets_at', 'source')
    last = None
    if os.path.exists(HISTORY):
        for ln in open(HISTORY):
            prev = json.loads(ln)
            last = prev if prev.get('pool') == pool else last
    if last and all(last.get(k) == row[k] for k in keys):
        return
    with open(HISTORY, 'a') as f:
        f.write(json.dumps(row) + '\n')


def watchdog_writes(now):
    try:
        return now - os.path.getmtime(PACE_FILE) < WRITER_QUIET_S
    except OSError:
        return False


def main():
    now = float(os.environ.get('PACE_NOW') or time.time())
    read_only = watchdog_writes(time.time())
    try:
        watchdog = json.load(open(WATCHDOG)).get('lastReadings') or {}
    except (OSError, ValueError):
        watchdog = {}
    for pool, cfg in pools().items():
        r = reading(pool, cfg, watchdog)
        if not r:
            print(f'PACE {pool:<8}no reading')
            continue
        print(pace_line(pool, r, float(cfg.get('reserve_seven_day', 14)), now))
        if not read_only:
            append_history(pool, r, now)


if __name__ == '__main__':
    main()
