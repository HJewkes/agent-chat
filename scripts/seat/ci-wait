#!/bin/bash
# Block until CI on a commit is green, red or out of time. REST only, never GraphQL.
# usage: ci-wait <owner/repo> <sha> [--timeout <seconds>] [--interval <seconds>] [--base <branch>]
# With required checks on the base branch (rulesets, else classic protection; default branch unless --base),
# GREEN needs each required context green the way bin/premerge judges it and ignores other runs.
# Without any, every check-run and status must pass and at least one check-run must exist.
# exit: 0 GREEN, 1 RED, 2 TIMEOUT (run again), 64 bad arguments or a commit GitHub does not have
set -u
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/sbin:/sbin:$PATH
GH=${GH:-gh}
usage() { echo "usage: ci-wait <owner/repo> <sha> [--timeout <seconds>] [--interval <seconds>] [--base <branch>]" >&2; exit 64; }

timeout=540 interval=30 base="" pos=()
while [ $# -gt 0 ]; do
  case $1 in
    --timeout|--interval)
      [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]] || usage
      [ "$1" = --timeout ] && timeout=$2 || interval=$2; shift 2 ;;
    --base)
      [ $# -ge 2 ] && [[ $2 =~ ^[A-Za-z0-9._/-]+$ ]] || usage
      base=$2; shift 2 ;;
    -*) usage ;;
    *) pos+=("$1"); shift ;;
  esac
done
[ ${#pos[@]} -eq 2 ] || usage
repo=${pos[0]} sha=${pos[1]}
[[ $repo =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || usage
[[ $sha =~ ^[0-9a-fA-F]{7,40}$ ]] || usage
sha=$(tr 'A-F' 'a-f' <<<"$sha")

# For a commit GitHub does not have, /status reports "pending", so polling ran to TIMEOUT (CC-849).
# Ask commits/<sha> until it answers: a sha expands it to the full one, "No commit found" exits 64
# (a 2 would tell the caller to run again), and any other failure is transient like a failed poll.
resolved=0
resolve() {
  local out
  if out=$("$GH" api "repos/$repo/commits/$sha" --jq .sha 2>&1); then
    [[ $out =~ ^[0-9a-f]{40}$ && $out == "$sha"* ]] && sha=$out
    resolved=1
  elif grep -q 'No commit found' <<<"$out"; then
    echo "need a full 40-hex sha of a pushed commit: no commit $sha in $repo" >&2; exit 64
  fi
}

# Mirrors bin/premerge: GET with -i, sets $code and $body.
ghget() {
  local raw
  raw=$("$GH" api -i "$1" 2>/dev/null)
  code=$(head -1 <<<"$raw" | awk '{print $2}')
  body=$(awk 'f{print} /^\r?$/{f=1}' <<<"$raw")
}

# Free-plan private repos answer 403 "Upgrade to GitHub Pro..." for rules: that means no rules.
upgrade_403() {
  [ "$code" = 403 ] && jq -e '.message|type=="string" and startswith("Upgrade to GitHub Pro")' <<<"$body" >/dev/null 2>&1
}

# Sets $rules to {"req": [contexts], "pins": {context: [app ids]}} the way bin/premerge reads them.
# Returns 1 on any other answer, so the caller retries and never judges without the required list.
load_rules() {
  local b=$base
  [ -n "$b" ] || b=$("$GH" api "repos/$repo" --jq .default_branch 2>/dev/null) || return 1
  [[ $b =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
  ghget "repos/$repo/rules/branches/$b"
  if upgrade_403; then code=200 body='[]'; fi
  [ "$code" = 200 ] || return 1
  rules=$(jq -ce 'if type != "array" then error("shape") else . end
    | [.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]]
    | {req: (map(.context) | unique), pins: (map(select(.integration_id != null)) | group_by(.context)
       | map({key: .[0].context, value: (map(.integration_id) | unique)}) | from_entries)}' <<<"$body" 2>/dev/null) || return 1
  [ "$(jq '.req|length' <<<"$rules")" != 0 ] && return 0
  ghget "repos/$repo/branches/$b/protection/required_status_checks"
  upgrade_403 && return 0
  case "$code" in 404) return 0 ;; 200) ;; *) return 1 ;; esac
  rules=$(jq -ce 'if type != "object" then error("shape") else {req: (.contexts // [] | unique), pins: {}} end' <<<"$body" 2>/dev/null)
}

# Prints "GREEN", "RED <list>" or "PENDING <names>" for the two --paginate --slurp payloads (arrays of pages)
# and the $rules object. Exits non-zero when the pages hold fewer items than total_count, so the caller retries.
classify() {
  python3 -c '
import json, sys
ACTIONS_APP = 15368  # bin/premerge accepts an unpinned required context only from GitHub Actions or a status
def collect(raw, key):
    pages = json.loads(raw)
    items = [i for p in pages for i in p[key]]
    if len(items) != pages[0]["total_count"]:
        sys.exit(1)
    return items
def newest(runs, name, app):
    mine = [r for r in runs if r["name"] == name and (r.get("app") or {}).get("id") == app]
    return max(mine, key=lambda r: r.get("started_at") or "") if mine else None
def judge(name, run, state):
    if (run and run["status"] == "completed" and run["conclusion"] == "success") or state == "success":
        return None
    if (run and run["status"] != "completed") or state == "pending" or (run is None and state is None):
        return ("pending", name)
    return ("bad", "%s=%s" % (name, run["conclusion"] if run else state))
def required(runs, statuses, req, pins):
    out = []
    for c in req:
        if c in pins:
            out += [judge(c, newest(runs, c, a), None) for a in pins[c]]
        else:
            state = next((s["state"] for s in statuses if s["context"] == c), None)
            out.append(judge(c, newest(runs, c, ACTIONS_APP), state))
    return [v for v in out if v]
def all_runs(runs, statuses):
    out = []
    for r in runs:
        if r["status"] != "completed":
            out.append(("pending", r["name"]))
        elif r["conclusion"] not in ("success", "skipped", "neutral"):
            out.append(("bad", "%s=%s" % (r["name"], r["conclusion"])))
    for s in statuses:
        if s["state"] == "pending":
            out.append(("pending", s["context"]))
        elif s["state"] != "success":
            out.append(("bad", "%s=%s" % (s["context"], s["state"])))
    if not runs and not any(k == "bad" for k, _ in out):
        out.append(("pending", "(no check-run yet)" if statuses else "(nothing reported yet)"))
    return out
runs = collect(sys.argv[1], "check_runs")
statuses = collect(sys.argv[2], "statuses")
rules = json.loads(sys.argv[3])
found = required(runs, statuses, rules["req"], rules["pins"]) if rules["req"] else all_runs(runs, statuses)
pending = [t for k, t in found if k == "pending"]
bad = [t for k, t in found if k == "bad"]
print("PENDING " + ", ".join(pending) if pending else "RED " + "; ".join(bad) if bad else "GREEN")
' "$1" "$2" "$rules"
}

# Sets $state; returns 1 on a transient gh or JSON failure. Reads the required list once.
poll() {
  local runs status
  [ -n "$rules" ] || load_rules || { rules=""; return 1; }
  runs=$("$GH" api --paginate --slurp "repos/$repo/commits/$sha/check-runs?per_page=100" 2>/dev/null) || return 1
  status=$("$GH" api --paginate --slurp "repos/$repo/commits/$sha/status?per_page=100" 2>/dev/null) || return 1
  state=$(classify "$runs" "$status" 2>/dev/null) || return 1
}

rules="" start=$SECONDS pending="(no successful poll)"
while :; do
  [ "$resolved" = 1 ] || resolve
  if poll; then
    case $state in
      GREEN) echo "GREEN $repo $sha"; exit 0 ;;
      RED*) echo "RED $repo $sha: ${state#RED }"; exit 1 ;;
      *) pending=${state#PENDING } ;;
    esac
  fi
  elapsed=$((SECONDS - start))
  if [ $((elapsed + interval)) -gt "$timeout" ]; then
    echo "TIMEOUT $repo $sha after ${elapsed}s: pending $pending"; exit 2
  fi
  sleep "$interval"
done
