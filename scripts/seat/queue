#!/bin/sh
# Edit a seat's queue file in place (charter section 4): done, park, add, move.
set -eu
usage() {
  cat >&2 <<USAGE
usage: bin/queue <seat> done <TASK> [--pr N]
       bin/queue <seat> park <TASK>
       bin/queue <seat> add <section> <text...>
       bin/queue <seat> move <TASK> <section>
TASK must be the leading id of the item: the first token after the list marker
(optionally in ** and followed by :), like TP-487 or agent-chat#234.
The 5,000 limit on a queue file counts bytes, not characters.
USAGE
  exit 2
}
fail() { echo "bin/queue: $*" >&2; exit 1; }

[ "$#" -ge 3 ] || usage
seat=$1 verb=$2
shift 2
root=${AUTONOMY_ROOT:-${ACTIVE_ROOT:+$ACTIVE_ROOT/claude-channels/sources/autonomy}}
[ -n "$root" ] || { echo "bin/queue: AUTONOMY_ROOT and ACTIVE_ROOT unset: export one" >&2; exit 2; }
file="$root/queues/$seat.md"
case "$seat" in */*|"") fail "bad seat name '$seat'" ;; esac
[ -f "$file" ] || fail "no queue file for seat '$seat' ($file)"

pr=
case "$verb" in
  done)
    task=$1 arg=
    if [ "$#" -ge 2 ]; then
      [ "$#" -eq 3 ] && [ "$2" = "--pr" ] || usage
      pr=${3#\#}
      case "$pr" in ""|*[!0-9]*) fail "--pr needs a number, got '$3'" ;; esac
    fi ;;
  park) [ "$#" -eq 1 ] || usage; task=$1 arg= ;;
  move) [ "$#" -eq 2 ] || usage; task=$1 arg=$2 ;;
  add) [ "$#" -ge 2 ] || usage; task= arg=$1; shift; text="$*" ;;
  *) usage ;;
esac

PROG=$(cat <<'AWK'
function die(m) { print "bin/queue: " m > "/dev/stderr"; failed = 1; exit 1 }
function norm(s) { s = tolower(s); gsub(/[- ]/, "", s); return s }
function isitem(s) { return s ~ /^(- |[0-9]+\. )/ }
function isblank(s) { return s ~ /^[ \t]*$/ }
function secidx(a,  s) {
  a = norm(a)
  if (a == "") return 0
  for (s = 1; s <= nsec; s++) if (index(head[s], a) == 1) return s
  return 0
}
function parse(  i, cur) {
  for (i = 1; i <= n; i++) {
    if (L[i] ~ /^## /) { cur++; head[cur] = norm(substr(L[i], 4)); hstart[cur] = i }
    sec[i] = cur
  }
  nsec = cur
}
function build(  i, b) {
  for (i = 1; i <= n; i++) {
    if (sec[i] > 0 && isitem(L[i])) { b++; bs[b] = be[b] = i; bsec[b] = sec[i]; lead[b] = leadid(L[i]) }
    else if (b > 0 && be[b] == i - 1 && sec[i] == bsec[b] && L[i] ~ /^[ \t]+[^ \t]/) be[b] = i
  }
  nblk = b
}
function leadid(s,  t, rest) {
  sub(/^(- |[0-9]+\. )/, "", s)
  sub(/^\*\*/, "", s)
  if (!match(s, /^([A-Z][A-Z0-9]*-[0-9]+|[A-Za-z0-9_.-]+#[0-9]+)/)) return ""
  t = substr(s, 1, RLENGTH); rest = substr(s, RLENGTH + 1)
  return rest ~ /^(\*\*)?:?(\*\*)?([ \t]|$)/ ? t : ""
}
function btext(b,  i, t) {
  for (i = bs[b]; i <= be[b]; i++) t = t L[i] "\n"
  return t
}
function hasword(t, tok, strict,  s, p, abs, before, after) {
  s = 1
  while ((p = index(substr(t, s), tok)) > 0) {
    abs = s + p - 1
    before = abs > 1 ? substr(t, abs - 1, 1) : ""
    after = substr(t, abs + length(tok), 2)
    if ((!strict || before !~ /[A-Za-z0-9]/) && after !~ /^[0-9]/ && after !~ /^[A-Za-z]/ && (!strict || after !~ /^\.[0-9]/)) return 1
    s = abs + 1
  }
  return 0
}
function find(scope,  b, c) {
  for (b = 1; b <= nblk; b++)
    if ((!scope || head[bsec[b]] ~ /^(inflight|next)/) && lead[b] == task) hit[++c] = b
  return c
}
function nomatch(where,  i, ls) {
  for (i = 1; i <= n; i++) if (hasword(L[i], task, 1)) ls = ls (ls == "" ? "" : ",") i
  if (ls == "") die("no item " where " names " task)
  die(task " is not the leading id of any item " where "; it appears at line(s) " ls)
}
function drop(b,  i) {
  for (i = bs[b]; i <= be[b]; i++) del[i] = 1
  if (bs[b] > 1 && isblank(L[bs[b] - 1]) && be[b] < n && isblank(L[be[b] + 1])) del[be[b] + 1] = 1
}
function nextnum(s,  i, m, v) {
  for (i = hstart[s] + 1; i <= n && sec[i] == s; i++)
    if (!del[i] && L[i] ~ /^[0-9]+\. /) { v = L[i] + 0; if (v > m) m = v }
  return m + 1
}
function numbered(s,  i) {
  if (head[s] ~ /^(next|morning)/) return 1
  for (i = hstart[s] + 1; i <= n && sec[i] == s; i++) if (!del[i] && L[i] ~ /^[0-9]+\. /) return 1
  return 0
}
function place(s, body,  i, pos, pre) {
  for (i = hstart[s] + 1; i <= n && sec[i] == s; i++) if (L[i] == "none") del[i] = 1
  pos = hstart[s]
  for (i = hstart[s] + 1; i <= n && sec[i] == s; i++) if (!del[i] && !isblank(L[i])) pos = i
  if (pos == hstart[s]) {
    if (pos < n && sec[pos + 1] == s && isblank(L[pos + 1]) && !del[pos + 1]) pos++
    else pre = "\n"
  }
  after[pos] = pre (numbered(s) ? nextnum(s) ". " : "- ") body
}
function take(b, s,  i, body) {
  body = L[bs[b]]; sub(/^(- |[0-9]+\. )/, "", body); body = body "\n"
  for (i = bs[b] + 1; i <= be[b]; i++) body = body L[i] "\n"
  drop(b)
  place(s, body)
}
function doneverb(  c, i, k) {
  c = find(1)
  if (!c) nomatch("in In flight or Next")
  for (i = 1; i <= c; i++)
    if (pr != "" && !hasword(btext(hit[i]), "#" pr, 0)) die("item naming " task " does not mention #" pr)
  for (i = 1; i <= c; i++) {
    for (k = bs[hit[i]]; k <= be[hit[i]]; k++) print L[k] > removed
    drop(hit[i])
  }
}
function moveverb(scope,  c, s) {
  s = secidx(arg)
  if (!s) die("unknown section '" arg "'")
  c = find(scope)
  if (!c) nomatch("anywhere")
  if (c > 1) die(task " names " c " items; refusing to " verb)
  take(hit[1], s)
}
function addverb(  s) {
  s = secidx(arg)
  if (!s) die("unknown section '" arg "'")
  if (text ~ /^[ \t]*$/) die("add needs item text")
  place(s, text "\n")
}
function emit(  i) {
  for (i = 1; i <= n; i++) {
    if (!del[i]) print L[i]
    if (i in after) printf "%s", after[i]
  }
}
BEGIN {
  verb = ENVIRON["Q_VERB"]; task = ENVIRON["Q_TASK"]; arg = ENVIRON["Q_ARG"]
  pr = ENVIRON["Q_PR"]; text = ENVIRON["Q_TEXT"]; removed = ENVIRON["Q_REMOVED"]
  if (verb != "add" && task !~ /^([A-Z][A-Z0-9]*-[0-9]+|[A-Za-z0-9_.-]+#[0-9]+)$/) die("'" task "' is not a task id like TP-487")
}
{ L[++n] = $0 }
END {
  if (failed) exit 1
  parse(); build()
  if (verb == "done") doneverb()
  else if (verb == "park") { arg = "morning"; moveverb(1) }
  else if (verb == "move") moveverb(0)
  else addverb()
  if (!failed) emit()
}
AWK
)

lock="$file.lock"
locked=
cleanup() {
  rm -f "${tmp:-}" "${removed:-}"
  [ -z "$locked" ] || rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

lock_age() {
  m=$(stat -c %Y "$lock" 2>/dev/null) || m=$(stat -f %m "$lock" 2>/dev/null) || return 1
  echo $(( $(date +%s) - m ))
}
acquire() {
  tries=0
  until mkdir "$lock" 2>/dev/null; do
    age=$(lock_age) || age=0
    if [ "$age" -gt 60 ]; then rmdir "$lock" 2>/dev/null || true; continue; fi
    tries=$((tries + 1))
    [ "$tries" -le 50 ] || fail "queue file is locked ($lock); nothing written"
    sleep 0.1
  done
  locked=1
}
acquire

dir=$(dirname "$file")
tmp=$(mktemp "$dir/.queue.XXXXXX")
cp -p "$file" "$tmp"
removed=$(mktemp "${TMPDIR:-/tmp}/queue-removed.XXXXXX")
sum=$(cksum < "$file")

Q_VERB=$verb Q_TASK=$task Q_ARG=$arg Q_PR=$pr Q_TEXT=${text:-} Q_REMOVED=$removed \
  awk "$PROG" "$file" > "$tmp" || exit 1

bytes=$(wc -c < "$tmp" | tr -d ' ')
[ "$bytes" -le 5000 ] || fail "result would be $bytes bytes, over the 5,000 limit; nothing written"
[ "$sum" = "$(cksum < "$file")" ] || fail "$file changed while it was being edited; nothing written"
mv "$tmp" "$file"
cat "$removed"
