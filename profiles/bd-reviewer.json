{
  "description": "Burndown reviewer: relay-reviewer's read-only grants, headless, isolation none so it lands in the implementer's worktree, on a lean bootstrap (only agent-chat and active-work MCP, no skills).",
  "model": "opus",
  "allowedTools": ["Read", "Bash", "Grep", "Glob", "mcp__active-work__*"],
  "disallowedTools": [
    "Write",
    "Edit",
    "Bash(agent-chat endorse:*)",
    "Bash(agent-chat dismiss:*)",
    "Bash(agent-chat send:*)",
    "Bash(agent-chat answer:*)",
    "Bash(agent-chat approve:*)",
    "Bash(agent-chat inbox:*)",
    "Bash(agent-chat agent:*)",
    "Bash(agent-chat service:*)",
    "Bash(agent-chat teleport:*)",
    "Bash(agent-chat mirror:*)",
    "Bash(agent-chat lifecycle:*)",
    "Bash(agent-chat burndown:*)",
    "Bash(gh pr merge:*)",
    "Bash(gh pr review:*)",
    "Bash(gh api:*)",
    "Bash(gh release:*)",
    "Bash(gh repo:*)",
    "Bash(npm publish:*)",
    "Bash(npx changeset:*)",
    "Bash(wrangler:*)",
    "Bash(launchctl:*)",
    "Bash(git push origin main:*)",
    "Bash(git push origin master:*)",
    "Bash(git push -u origin main:*)",
    "Bash(git push -u origin master:*)",
    "Bash(git push --set-upstream origin main:*)",
    "Bash(git push --set-upstream origin master:*)",
    "Bash(git push origin HEAD:main:*)",
    "Bash(git push origin HEAD:master:*)",
    "Bash(git push origin :main:*)",
    "Bash(git push origin :master:*)",
    "Bash(git push -f:*)",
    "Bash(git push --force:*)",
    "Bash(git push --force-with-lease:*)",
    "Bash(git push origin -f:*)",
    "Bash(git push origin --force:*)",
    "Bash(git push origin --force-with-lease:*)",
    "Bash(git push --delete:*)",
    "Bash(git push -d:*)",
    "Bash(git push origin --delete:*)",
    "Bash(git push origin -d:*)",
    "Bash(git stash:*)",
    "Monitor",
    "ScheduleWakeup",
    "AskUserQuestion"
  ],
  "isolation": "none",
  "surface": "headless",
  "surfaceLifetime": "close-on-exit",
  "promptPrelude": "You are headless: no one is watching and no pane can answer a permission prompt. You are reviewing, not implementing, for the burndown loop. The working directory is the worktree a burndown implementer just finished in; its branch holds the changes. Read the diff against the base branch, run the project's tests, and report correctness, missed requirements, and anything a human must look at before merge. Do not change the code: your grants are read-only by design, so a fix you want made is something to describe, not to apply.",
  "strictMcpConfig": true,
  "disableSlashCommands": true,
  "mcpServers": {
    "active-work": {
      "type": "http",
      "url": "http://127.0.0.1:7400/mcp"
    }
  },
  "env": {
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "5m"
  }
}
