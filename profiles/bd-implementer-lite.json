{
  "description": "Burndown implementer for small, fully specified briefs: implementer-lite's model (sonnet), headless, in its own worktree, on a lean bootstrap (only agent-chat and active-work MCP, no skills).",
  "model": "sonnet",
  "allowedTools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob", "Monitor", "mcp__active-work__*"],
  "disallowedTools": [
    "Bash(agent-chat endorse:*)",
    "Bash(agent-chat dismiss:*)",
    "Bash(agent-chat send:*)",
    "Bash(agent-chat answer:*)",
    "Bash(agent-chat approve:*)",
    "Bash(agent-chat inbox:*)",
    "Bash(agent-chat agent:*)",
    "Bash(agent-chat service:*)",
    "Bash(agent-chat teleport:*)",
    "Bash(agent-chat mirror:*)",
    "Bash(agent-chat lifecycle:*)",
    "Bash(agent-chat burndown:*)",
    "Bash(gh pr merge:*)",
    "Bash(gh pr review:*)",
    "Bash(gh api:*)",
    "Bash(gh release:*)",
    "Bash(gh repo:*)",
    "Bash(npm publish:*)",
    "Bash(npx changeset:*)",
    "Bash(wrangler:*)",
    "Bash(launchctl:*)",
    "Bash(git push origin main:*)",
    "Bash(git push origin master:*)",
    "Bash(git push -u origin main:*)",
    "Bash(git push -u origin master:*)",
    "Bash(git push --set-upstream origin main:*)",
    "Bash(git push --set-upstream origin master:*)",
    "Bash(git push origin HEAD:main:*)",
    "Bash(git push origin HEAD:master:*)",
    "Bash(git push origin :main:*)",
    "Bash(git push origin :master:*)",
    "Bash(git push -f:*)",
    "Bash(git push --force:*)",
    "Bash(git push --force-with-lease:*)",
    "Bash(git push origin -f:*)",
    "Bash(git push origin --force:*)",
    "Bash(git push origin --force-with-lease:*)",
    "Bash(git push --delete:*)",
    "Bash(git push -d:*)",
    "Bash(git push origin --delete:*)",
    "Bash(git push origin -d:*)",
    "AskUserQuestion"
  ],
  "isolation": "worktree",
  "surface": "headless",
  "surfaceLifetime": "close-on-exit",
  "promptPrelude": "You are headless: no one is watching and no pane can answer a permission prompt. You are implementing a small, fully specified change in an isolated worktree. Follow the brief literally: the tests it names are the acceptance criteria, so write them first and make them pass. Do not redesign, widen scope, or touch files outside the ownership set the brief gives you; if the brief is ambiguous or the change turns out larger than described, stop and report BLOCKED with what you found instead of guessing. Run the project's full gates before reporting done.",
  "strictMcpConfig": true,
  "disableSlashCommands": true,
  "mcpServers": {
    "active-work": {
      "type": "http",
      "url": "http://127.0.0.1:7400/mcp"
    }
  }
}
