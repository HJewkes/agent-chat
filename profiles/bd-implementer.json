{
  "description": "Burndown implementer: the builtin implementer (opus), headless, in its own worktree, on a lean bootstrap (only agent-chat and active-work MCP, no skills).",
  "model": "opus",
  "allowedTools": ["Read", "Write", "Edit", "Bash", "Grep", "Glob", "Monitor", "mcp__active-work__*"],
  "disallowedTools": [
    "Bash(agent-chat endorse:*)",
    "Bash(agent-chat dismiss:*)",
    "Bash(agent-chat send:*)",
    "Bash(agent-chat answer:*)",
    "Bash(agent-chat approve:*)",
    "Bash(agent-chat ask:*)",
    "Bash(agent-chat inbox:*)",
    "Bash(agent-chat agent:*)",
    "Bash(agent-chat service:*)",
    "Bash(agent-chat teleport:*)",
    "Bash(agent-chat mirror:*)",
    "Bash(agent-chat lifecycle:*)",
    "Bash(agent-chat burndown:*)",
    "Bash(gh pr merge:*)",
    "Bash(gh pr review:*)",
    "Bash(gh api:*)",
    "Bash(gh release:*)",
    "Bash(gh repo:*)",
    "Bash(npm publish:*)",
    "Bash(npx changeset:*)",
    "Bash(wrangler:*)",
    "Bash(launchctl:*)",
    "Bash(git push origin main:*)",
    "Bash(git push origin master:*)",
    "Bash(git push -u origin main:*)",
    "Bash(git push -u origin master:*)",
    "Bash(git push --set-upstream origin main:*)",
    "Bash(git push --set-upstream origin master:*)",
    "Bash(git push origin HEAD:main:*)",
    "Bash(git push origin HEAD:master:*)",
    "Bash(git push origin :main:*)",
    "Bash(git push origin :master:*)",
    "Bash(git push -f:*)",
    "Bash(git push --force:*)",
    "Bash(git push --force-with-lease:*)",
    "Bash(git push origin -f:*)",
    "Bash(git push origin --force:*)",
    "Bash(git push origin --force-with-lease:*)",
    "Bash(git push --delete:*)",
    "Bash(git push -d:*)",
    "Bash(git push origin --delete:*)",
    "Bash(git push origin -d:*)",
    "AskUserQuestion"
  ],
  "isolation": "worktree",
  "surface": "headless",
  "surfaceLifetime": "close-on-exit",
  "promptPrelude": "You are headless: no one is watching and no pane can answer a permission prompt. You are implementing in an isolated worktree. Keep diffs small and reviewable, and run the project's tests before reporting done. Post a body or comment in one call: `agent-chat gh-write -- <gh args> --body-file - <<'EOF'`, text, EOF, no file. pr-ready's <f>: a .md Write put in your own worktree, deleted after. Quote expansions in git and gh args (`git -C \"$dir\"`); never hold a command name in a variable.",
  "strictMcpConfig": true,
  "disableSlashCommands": true,
  "mcpServers": {
    "active-work": {
      "type": "http",
      "url": "http://127.0.0.1:7400/mcp"
    }
  }
}
